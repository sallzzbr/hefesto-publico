    {
      "id": "boundary-single-consumer",
      "category": "boundaries",
      "prompt": "Revise o adaptador usado por um consumidor. Considere o isolamento de I/O e a possibilidade de testar falhas sem rede.",
      "files": [
        {
          "path": "src/checkout.js",
          "content": "export async function checkout(total, paymentGateway) {\n  if (!Number.isInteger(total) || total <= 0) throw new TypeError('Invalid total');\n  return paymentGateway.charge(total);\n}\n"
        },
        {
          "path": "src/payment-gateway.js",
          "content": "export function paymentGateway(client) {\n  return { charge: total => client.post('/charges', { total }) };\n}\n"
        },
        {
          "path": "tests/checkout.test.js",
          "content": "import assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { checkout } from '../src/checkout.js';\ntest('rejects invalid total before external I/O', async () => {\n  let called = false;\n  await assert.rejects(checkout(0, { charge() { called = true; } }), TypeError);\n  assert.equal(called, false);\n});\n"
        }
      ],
      "expected": [
        {
          "id": "Q-BOUNDARIES",
          "status": "satisfied",
          "rationale": "checkout valida seu total antes de I/O. O adaptador com um consumidor isola o serviço remoto e permite simular falhas; contagem de chamadores não demonstra abstração indevida."
        }
      ]
    },
